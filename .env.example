# 8-Bit Jukebox MVP Configuration

# Host Admin PIN for /host dashboard and WebSocket commands
HOST_PIN=1234

# Google Gemini API Key (for AI-Driven 8-Bit Scene & Animation Engine)
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Public/LAN URL override for the QR Code on Big Screen
# Leave blank to auto-detect local LAN IP (e.g. http://192.168.1.50:8000/mobile)
PUBLIC_URL=

# Audio cache directory
AUDIO_CACHE_DIR=/tmp/audio_cache

# Server Port
PORT=8000
